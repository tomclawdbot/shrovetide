{
  "name": "shrovetide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Top-down sports game with a headless simulation core (Phaser 3 client + pure-TS sim).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test:sim": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "matter-js": "^0.20.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=20"
  }
}
